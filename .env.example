# Copy to .env and source it, or paste into your shell profile.
# Every one of these has a default — nothing here is required to get started.

# Where derived data, the database and renders live.
export ORBITCUT_ROOT="$HOME/orbitcut"

# videotoolbox (Apple) | cuda (NVIDIA) | none (software).
# The laptop ingests normally; the desktop is a working fallback.
export ORBITCUT_HWACCEL=videotoolbox

# Proxy size and quality. 540p is plenty for scoring and review.
export ORBITCUT_PROXY_HEIGHT=540
export ORBITCUT_PROXY_BITRATE=2M

# Archive destination — the desktop share. Unset until it's mounted.
# The archive stage refuses to run without it, which is deliberate.
# export ORBITCUT_ARCHIVE="/Volumes/orbitcut/originals"
